# ==========================================
# 5th Avenue Beauty Emporium Environment Variables
# ==========================================
# Copy to .env (and/or backend/.env) and fill in real values.
# This template ships with placeholders only — never commit real secrets.

# Application Environment
APP_ENV=development
PORT=8080

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=beauty_emporium
DATABASE_URL=postgres://postgres:change-me@postgres:5432/beauty_emporium?sslmode=disable

# Redis
REDIS_URL=redis:6379

# JWT Security — REQUIRED in production. Generate a strong value:
#   openssl rand -base64 48
JWT_SECRET=

# Bootstrap admin emails (comma separated). Elevates role only at signup;
# later role changes are managed in the database.
ADMIN_EMAILS=admin@5thavenue.ie

# Google OAuth2 (Optional for local dev, mock fallback supported)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Twilio SMS (Optional for local dev, console mock fallback active)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP email (optional; ticket notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=concierge@5thavenue.ie

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
